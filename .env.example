# Existing Sanity project (do not create another).
SANITY_PROJECT_ID=59vrectd
SANITY_DATASET=production

# Optional Context slug once a Sanity Context document exists.
# SANITY_CONTEXT_SLUG=sounding

# Leave empty in the repo. Set locally if you want the live Context MCP.
SANITY_API_READ_TOKEN=

# Optional: prefer a Knowledge Base MCP URL over the slug endpoint.
# SANITY_KB_MCP_URL=

# Without a read token the app stays in fixture mode and reads sanity/seed.ndjson
# through the same initial_context / schema_explorer / groq_query / array_field_reader tools.

# Optional: tool-calling loop (max 8 calls). First key found wins.
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Studio / CLI (same project; no token here).
SANITY_STUDIO_PROJECT_ID=59vrectd
SANITY_STUDIO_DATASET=production
